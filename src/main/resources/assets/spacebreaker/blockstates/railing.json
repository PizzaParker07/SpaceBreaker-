{
  "multipart": [
    {
      "apply": {
        "model": "spacebreaker:block/railing_post_ends"
      }
    },
    {
      "when": {
        "north": "false",
        "west": "false",
        "south": "false",
        "east": "false"
      },
      "apply": {
        "model": "spacebreaker:block/railing_post"
      }
    },
    {
      "when": {
        "north": "true",
        "west": "false",
        "south": "false",
        "east": "false"
      },
      "apply": {
        "model": "spacebreaker:block/railing_cap"
      }
    },
    {
      "when": {
        "north": "false",
        "west": "false",
        "south": "false",
        "east": "true"
      },
      "apply": {
        "model": "spacebreaker:block/railing_cap",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false",
        "west": "false",
        "south": "true",
        "east": "false"
      },
      "apply": {
        "model": "spacebreaker:block/railing_cap_alt"
      }
    },
    {
      "when": {
        "north": "false",
        "west": "true",
        "south": "false",
        "east": "false"
      },
      "apply": {
        "model": "spacebreaker:block/railing_cap_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "spacebreaker:block/railing_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "spacebreaker:block/railing_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "spacebreaker:block/railing_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "spacebreaker:block/railing_side_alt",
        "y": 90
      }
    }
  ]
}
