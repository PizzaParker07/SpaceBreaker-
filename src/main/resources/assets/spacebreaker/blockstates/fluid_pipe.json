{
  "multipart": [
    {
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_core"
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "connected"
          },
          {
            "north": "extract"
          }
        ]
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_north"
      }
    },
    {
      "when": {
        "north": "extract"
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_north_extract"
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "connected"
          },
          {
            "south": "extract"
          }
        ]
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_south"
      }
    },
    {
      "when": {
        "south": "extract"
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_south_extract"
      }
    },
    {
      "when": {
        "OR": [
          {
            "east": "connected"
          },
          {
            "east": "extract"
          }
        ]
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_east"
      }
    },
    {
      "when": {
        "east": "extract"
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_east_extract"
      }
    },
    {
      "when": {
        "OR": [
          {
            "west": "connected"
          },
          {
            "west": "extract"
          }
        ]
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_west"
      }
    },
    {
      "when": {
        "west": "extract"
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_west_extract"
      }
    },
    {
      "when": {
        "OR": [
          {
            "up": "connected"
          },
          {
            "up": "extract"
          }
        ]
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_up"
      }
    },
    {
      "when": {
        "up": "extract"
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_up_extract"
      }
    },
    {
      "when": {
        "OR": [
          {
            "down": "connected"
          },
          {
            "down": "extract"
          }
        ]
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_down"
      }
    },
    {
      "when": {
        "down": "extract"
      },
      "apply": {
        "model": "spacebreaker:block/fluid_pipe_down_extract"
      }
    }
  ]
}
